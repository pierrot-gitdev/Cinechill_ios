          "stringUnit" : {
            "state" : "translated",
            "value" : "On ne proposera que des films adaptés aux enfants."
          }
        }
      }
    },
    "On ne sait encore rien de vous. À chaque film que vous marquez comme vu et à chaque recherche, cette page se remplit — et il y a de moins en moins de questions à vous poser." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't know anything about you yet. With every film you mark as watched and every search, this page fills in — and there are fewer and fewer questions to ask you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On ne sait encore rien de vous. À chaque film que vous marquez comme vu et à chaque recherche, cette page se remplit — et il y a de moins en moins de questions à vous poser."
          }
        }
      }
    },
