        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On ne sait encore rien de toi. À chaque film que tu marques comme vu et à chaque recherche, cette page se remplit, et il y a de moins en moins de questions à te poser."
          }
        }
      }
    },
