        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seventeen-year-old Marty McFly is thrown thirty years into the past by an eccentric scientist's time machine. There he runs into his teenage parents and accidentally jeopardises their first meeting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
