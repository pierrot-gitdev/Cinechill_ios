            "value" : "On n'a plus d'autres films à vous proposer avec ces critères. Recommencez une recherche pour élargir."
          }
        }
      }
    },
    "On ne proposera que des films adaptés aux enfants." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll only suggest films suitable for children."
